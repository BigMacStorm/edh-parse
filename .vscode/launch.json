{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "edhparse --help",
            "type": "debugpy",
            "request": "launch",
            "module": "edhparse",
            "args": ["--help"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "edhparse web",
            "type": "debugpy",
            "request": "launch",
            "module": "edhparse",
            "args": ["web", "--no-open"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "edhparse summary (HTML)",
            "type": "debugpy",
            "request": "launch",
            "module": "edhparse",
            "args": [
                "summary",
                "--commanders",
                "inputs/comlist",
                "--stock",
                "inputs/Stock.csv",
                "--write-html"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Legacy argparse CLI",
            "type": "debugpy",
            "request": "launch",
            "module": "edhparse.cli",
            "args": ["-cl", "inputs/comlist", "-mb", "inputs/Stock.csv", "-html"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
